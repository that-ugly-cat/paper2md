# Required to enable the admin panel (/admin) — issuing/managing API keys.
# Leave empty to keep the admin panel disabled (login always rejected).
ADMIN_PASSWORD=

# Signs the admin session cookie — set a long random value in production.
SECRET_KEY=paper2md-dev-secret-change-me

# How the admin is recognised. `local` (the default) uses ADMIN_PASSWORD above.
# `gateway` instead trusts the X-Borant-* headers set by an SSO gate in front,
# and switches the local login off. Only ever set `gateway` when such a gate
# really is in front of the app: without one, anyone can send those headers.
# Keep ADMIN_PASSWORD populated either way — it is what you fall back to.
AUTH_MODE=local

# gateway mode only: the address the reverse proxy connects from. Anything
# arriving from anywhere else has its X-Borant-* headers ignored. Under Docker
# this is a bridge gateway and NOT 127.0.0.1, and with more than one network
# attached it may not be the one you expect — DEPLOY.md §9 shows how to read the
# real value off a running container. Addresses or CIDRs, comma-separated.
BORANT_TRUSTED_PROXY=127.0.0.1

# gateway mode only: where "log out" sends the browser, so the central session
# is revoked too and not just the local cookie.
BORANT_LOGOUT_URL=https://id.borant.eu/logout

# Upload size caps
ANON_MAX_UPLOAD_MB=10
API_MAX_UPLOAD_MB=50

# Optional tuning (defaults shown)
MAX_QUEUE_DEPTH=10
CONVERT_TIMEOUT_SECONDS=300
