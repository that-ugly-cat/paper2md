services:
  app:
    build: .
    container_name: paper2md
    restart: unless-stopped
    ports:
      - "127.0.0.1:8008:8000"
    env_file:
      - .env
    # Guardrail on a shared box: cap this service to one CPU so a conversion
    # burst can't starve the other containers, and bound its RAM. Don't go
    # below 4g: with Docling 2.129 a 12-page paper peaks around 1.8 GiB, and at
    # 2000m longer PDFs got the container killed mid-conversion, which clients
    # see as a connection closed without a response.
    cpus: "1.0"
    mem_limit: 4g
    volumes:
      - ./model-cache:/root/.cache
      - ./data:/app/data

# ── Co-located clients (optional, deployment-specific) ────────────────────────
# When another container on the same host converts PDFs through this service,
# route it container-to-container instead of through the public URL: a proxy in
# front (Cloudflare's ~100s ceiling, for one) times out on exactly the large PDFs
# that need converting, and the client sees a 524 it can do nothing about.
#
#   docker network create paper2md-shared
#
# then uncomment on the service above:
#   networks: [default, paper2md-shared]
# and at the end of the file:
#   networks:
#     paper2md-shared:
#       external: true
#
# Clients join the same network and use http://paper2md:8000. The loopback port
# binding stays, so the proxy and anything on the host keep working.

# ── Pin the default network's subnet, if this app sits behind a gate ──────────
# The gateway of a compose project's default network is the address the app sees
# as the source of proxied requests, and gated borant apps carry it in
# BORANT_TRUSTED_PROXY. Docker hands those subnets out in creation order, so a
# restart in a different order changes the gateway silently — and the app then
# refuses the gate's identity headers with a 503 that reads like a broken gate
# and is an IP address. Pinning settles it:
#
#   networks:
#     default:
#       ipam:
#         config:
#           - subnet: 10.200.101.0/24   # any free /24 in your Docker pool
